Output demos/gifs/demo_testing_video.mp4
Set FontSize 14
Set Width 1200
Set Height 800
Set Theme {
  "name": "Fedora GNOME Dark",
  "background": "#1e1e1e",
  "foreground": "#ffffff",
  "cursor": "#ffffff",
  "selection": "#545454",
  "black": "#242424",
  "red": "#f66151",
  "green": "#33da7a",
  "yellow": "#f9e057",
  "blue": "#62a0ea",
  "magenta": "#dc8add",
  "cyan": "#93cee9",
  "white": "#f6f5f4",
  "brightBlack": "#5e5c64",
  "brightRed": "#ff7b63",
  "brightGreen": "#62e49d",
  "brightYellow": "#fdf37d",
  "brightBlue": "#78aeed",
  "brightMagenta": "#f0a2f2",
  "brightCyan": "#b5e0f2",
  "brightWhite": "#ffffff"
}

Type "./scripts/run_testing_pipeline.sh"
Enter
Sleep 660s 